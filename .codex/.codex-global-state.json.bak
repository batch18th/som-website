{"electron-persisted-atom-state":{"electron:onboarding-projectless-completed":true,"electron:onboarding-workspace-experiment-assignment":{"arm":"control","assignedAtMs":1777702174537,"experimentName":"93537254"},"electron:onboarding-primary-runtime-install-ready":false,"electron:onboarding-primary-runtime-install-requested":true,"electron:onboarding-welcome-pending":true,"environment":null,"agent-mode-by-host-id":{"local":"auto"},"fast-mode-personalized-estimate":{"estimatedSavedMs":404850,"rolloutCountWithCompletedTurns":3,"computedAtMs":1777769547585},"skip-full-access-confirm":true,"composer-auto-context-enabled":false,"sidebar-collapsed-sections-v1":{"chats":false,"pinned":false,"threads":false},"sidebar-collapsed-groups":{"D:\\My codex Files":true,"D:\\som-website-codex":true},"preferred-non-full-access-agent-mode-by-host-id":{"local":null},"sidebar-organize-mode-v1":"recent","prompt-history":["You are an expert senior Next.js developer, UI/UX designer, CRO specialist, and direct-response landing page strategist.\r\n\r\nBuild a production-ready personal portfolio website for a Meta Ads expert.\r\n\r\nWebsite purpose:\r\nA personal portfolio website for a Meta Ads expert who helps business owners replace random posting, boosted posts, weak ads, and guesswork with a complete Meta Ads system that brings real inquiries, qualified leads, bookings, and sales.\r\n\r\nTheme:\r\nLight theme. Modern SaaS/startup style. Clean, minimal, professional, conversion-focused, trustworthy, and easy to read on mobile.\r\n\r\nPrimary conversion goal:\r\nGet business owners to book a free Meta Ads audit or message on WhatsApp.\r\n\r\nMain CTAs:\r\n- Book Your Free Meta Ads Audit\r\n- Message Us on WhatsApp\r\n\r\nTECH REQUIREMENTS:\r\nUse the latest version of Next.js with the App Router.\r\nUse Tailwind CSS.\r\nCreate a clean and scalable project structure.\r\nMake the website fully responsive across mobile, tablet, and desktop.\r\nWrite production-ready, maintainable code.\r\nOptimize for fast performance.\r\nUse reusable components.\r\nUse semantic HTML.\r\nUse accessible buttons, links, sections, and forms.\r\nUse clean spacing, readable typography, and strong visual hierarchy.\r\nAvoid unnecessary animation that slows performance.\r\nAdd subtle, smooth animations only where they improve the user experience.\r\n\r\nSEO REQUIREMENTS:\r\nAdd proper metadata using Next.js metadata API.\r\nMeta title: Meta Ads Expert | Predictable Lead Growth System\r\nMeta description: Stop boosting posts that get likes but no customers. Build a Meta Ads system that brings qualified leads, real inquiries, bookings, and measurable growth.\r\nAdd Open Graph tags.\r\nUse proper heading hierarchy: one H1, then H2 and H3 correctly.\r\nUse semantic sections.\r\nMake the layout SEO-friendly and fast-loading.\r\nUse descriptive alt text for any images or placeholders.\r\nUse clean URLs and page structure.\r\n\r\nDESIGN DIRECTION:\r\nCreate a light-themed modern portfolio/landing page.\r\nStyle should feel like a premium SaaS/startup website, not a generic freelancer page.\r\nUse a mostly white or very light background.\r\nUse soft gradients, subtle shadows, rounded cards, clean borders, and professional spacing.\r\nUse a strong accent color suitable for Meta Ads/business growth, such as blue, indigo, or a blue-purple gradient.\r\nUse clear typography with large bold headlines and easy-to-read body text.\r\nUse conversion-focused layout with repeated CTAs.\r\nDesign must feel trustworthy, calm, clear, and premium.\r\nMake it mobile-first.\r\n\r\nWEBSITE STRUCTURE:\r\nBuild a single high-converting landing page with these sections:\r\n\r\n1. Header / Navigation\r\n2. Hero section with strong value proposition\r\n3. Pain / hook section\r\n4. Problem agitation section\r\n5. Solution introduction\r\n6. How it works section\r\n7. Benefits and outcomes section\r\n8. What’s included section\r\n9. Bonuses section\r\n10. Social proof / credibility section\r\n11. Objection handling section\r\n12. Risk reversal / reassurance section\r\n13. Urgency / scarcity section\r\n14. FAQ section\r\n15. Final call-to-action section\r\n16. Footer\r\n\r\nHEADER:\r\nCreate a sticky or clean top navigation.\r\nLogo/name placeholder: “Meta Ads Expert”\r\nNavigation links:\r\n- Problem\r\n- System\r\n- Process\r\n- Results\r\n- FAQ\r\nCTA button: Book Free Audit\r\n\r\nHERO SECTION:\r\nUse this copy and improve only formatting, not meaning:\r\n\r\nHeadline:\r\nStop Boosting Posts That Get Likes But No Customers\r\n\r\nSubheadline:\r\nTurn Facebook and Instagram into a predictable customer-generating system that brings real inquiries, qualified leads, bookings, and sales.\r\n\r\nSupport copy:\r\nWe help business owners replace random posting, weak boosted ads, and guesswork with a complete Meta Ads system built to attract people who are actually ready to buy.\r\n\r\nPrimary CTA:\r\nBook Your Free Meta Ads Audit\r\n\r\nSecondary CTA:\r\nMessage Us on WhatsApp\r\n\r\nAdd trust microcopy near the CTA:\r\nNo pressure. No confusing jargon. Just a clear look at what is working and what is not.\r\n\r\nHero visual:\r\nCreate a clean dashboard-style visual card showing:\r\n- Qualified Leads\r\n- Real Inquiries\r\n- Bookings\r\n- Sales Opportunities\r\n- Ad Spend Clarity\r\nUse placeholder metrics, but make them look realistic and clearly mark them as examples if needed.\r\n\r\nHOOK SECTION:\r\nUse short emotional copy with strong spacing:\r\n\r\nIf this sounds familiar, you are not alone.\r\n\r\nYou post on Facebook and Instagram.\r\nYou boost a few posts.\r\nYou get some likes, comments, and maybe a few messages.\r\n\r\nBut when you check the real result…\r\n\r\nNo serious buyers.\r\nNo consistent bookings.\r\nNo clear return.\r\nNo idea what is working.\r\n\r\nAnd the worst part?\r\n\r\nYou know your business is good.\r\nYou know your product or service can help people.\r\nBut not enough people are seeing it, trusting it, or buying from you.\r\n\r\nDesign this section with a clean two-column layout on desktop:\r\nLeft side: emotional copy.\r\nRight side: a card titled “What usually happens” with bullet points:\r\n- Likes but no customers\r\n- Messages that disappear\r\n- Weak lead quality\r\n- Unclear return\r\n- Random monthly sales\r\n\r\nPROBLEM AGITATION SECTION:\r\nHeading:\r\nThe problem is not that Meta Ads “don’t work.”\r\n\r\nSubheading:\r\nThe problem is that most businesses are using them the wrong way.\r\n\r\nInclude these problem points in cards:\r\n- Boosting posts without a strategy\r\n- Running ads without a strong offer\r\n- Copying competitors and hoping something works\r\n- Sending traffic to weak pages or messy inboxes\r\n- Judging ads too early\r\n- Stopping campaigns before proper testing\r\n- Looking at likes, clicks, and reach instead of leads, bookings, and sales\r\n\r\nAdd copy:\r\nThat is why it feels like you are spending money but not moving forward.\r\n\r\nAdd quote-style cards:\r\n“I tried ads before and they didn’t work.”\r\n“People message ‘price?’ and disappear.”\r\n“I need more customers, not just engagement.”\r\n“Some months are good, some months are terrible.”\r\n“I want to grow, but I don’t understand all this technical stuff.”\r\n\r\nEnd section with:\r\nThis is exactly why you do not need “just ads.”\r\nYou need a system.\r\n\r\nSOLUTION INTRODUCTION SECTION:\r\nHeading:\r\nIntroducing The Predictable Lead Growth System\r\n\r\nCopy:\r\nA complete Meta Ads system designed to help business owners get more qualified leads, inquiries, bookings, calls, or online sales from Facebook and Instagram.\r\n\r\nWe do not just run ads.\r\nWe help build the full customer journey.\r\n\r\nThat means we look at your offer, audience, ad message, creative, campaign setup, tracking, retargeting, and follow-up process.\r\n\r\nBecause ads alone do not grow a business.\r\nA working system does.\r\n\r\nHighlight box:\r\nThe goal is simple:\r\nTo help you stop guessing and start knowing what is bringing customers into your business.\r\n\r\nAdd CTA:\r\nBook Your Free Meta Ads Audit\r\nMessage Us on WhatsApp\r\n\r\nHOW IT WORKS SECTION:\r\nHeading:\r\nHow The System Works\r\n\r\nCreate four step cards with numbers and icons:\r\n\r\nStep 1: We Audit What You Are Doing Now\r\nCopy:\r\nFirst, we look at your current marketing, ads, boosted posts, offer, audience, landing page or lead form, follow-up process, and results. We find where things are breaking. No guessing. No confusing jargon.\r\n\r\nStep 2: We Build Your Growth Strategy\r\nCopy:\r\nNext, we create a simple campaign roadmap. We decide what offer to promote, who to target, what message to use, what type of creative to test, where leads should go, how to track results, and how to follow up.\r\n\r\nStep 3: We Launch Your Meta Ads System\r\nCopy:\r\nThen we set up and manage your campaigns across Facebook and Instagram. This can include lead generation campaigns, message campaigns, retargeting, creative testing, and tracking setup.\r\n\r\nStep 4: We Track, Optimize, and Improve\r\nCopy:\r\nOnce your campaigns are live, we monitor the numbers, check lead quality, test new creatives, adjust campaigns, and show you what is happening in simple reports.\r\n\r\nBENEFITS SECTION:\r\nHeading:\r\nWhat This Can Help You Do\r\n\r\nCreate benefit cards:\r\n1. Get More Qualified Inquiries\r\nCopy: Not just random likes or people asking for discounts. The goal is to attract people who understand your offer and are more likely to become customers.\r\n\r\n2. Stop Depending Only on Referrals\r\nCopy: Referrals are great, but they are not predictable. With the right Meta Ads system, your business can start building a steadier pipeline of prospects.\r\n\r\n3. Know What Is Actually Working\r\nCopy: No more wondering whether your posts, ads, or budget are helping. You get simple reporting that shows what is bringing leads, inquiries, bookings, or sales.\r\n\r\n4. Feel More in Control of Growth\r\nCopy: You should not have to wake up every day hoping business will be good. The goal is to create a system that gives you more clarity, confidence, and control.\r\n\r\n5. Spend Smarter, Not Randomly\r\nCopy: We help you avoid wasting money on boosted posts, weak offers, unclear targeting, and campaigns with no tracking.\r\n\r\nWHAT’S INCLUDED SECTION:\r\nHeading:\r\nThe Predictable Lead Growth System Includes\r\n\r\nUse a grid of clean cards:\r\n- Business & Ad Account Audit: We review your current setup and find the biggest leaks.\r\n- Offer Strategy: We help position your offer so it is easier for people to understand and respond to.\r\n- Audience Research: We identify the people most likely to need your product or service.\r\n- Ad Copywriting: We write clear, simple, persuasive ad copy that speaks to your customer’s real pain and desire.\r\n- Creative Direction: We guide the ad visuals, videos, hooks, and angles that should be tested.\r\n- Campaign Setup: We build your Meta Ads campaigns properly instead of relying on random boosting.\r\n- Tracking Setup Guidance: We help you understand what should be tracked so you can judge results properly.\r\n- Lead Form or Landing Page Guidance: We help improve the path people take after they click your ad.\r\n- Retargeting Campaigns: We help bring back people who showed interest but did not take action yet.\r\n- Weekly Optimization: We monitor, adjust, and improve campaigns based on performance.\r\n- Simple Performance Reporting: No confusing dashboards. Just clear reporting on what matters.\r\n- Lead Follow-Up Recommendations: Because leads only matter if they are followed up properly.\r\n\r\nBONUSES SECTION:\r\nHeading:\r\nIncluded Bonuses\r\n\r\nCreate four highlighted bonus cards:\r\nBonus 1: Meta Ads Leak Audit\r\nCopy: We identify what may be causing wasted spend, poor lead quality, or low conversions.\r\n\r\nBonus 2: Offer Clarity Review\r\nCopy: Many businesses do not have an ad problem. They have an offer problem. We help review your offer so people instantly understand why they should contact you.\r\n\r\nBonus 3: Lead Follow-Up Checklist\r\nCopy: Getting leads is only the first step. We give you a simple checklist to help your team respond faster, qualify better, and avoid losing interested prospects.\r\n\r\nBonus 4: “Boost Post vs Real Campaign” Breakdown\r\nCopy: You will understand why boosted posts often bring likes instead of customers, and what a proper campaign should do differently.\r\n\r\nSOCIAL PROOF / CREDIBILITY SECTION:\r\nHeading:\r\nReal Businesses Need Real Results\r\n\r\nUse placeholder-style proof angles because exact client results are not provided.\r\nMake it visually credible but do not invent fake numbers.\r\n\r\nCreate cards:\r\nCase Study Placeholder:\r\n“How we helped a local service business move from random boosted posts to a structured lead generation campaign that brought steady inquiries.”\r\n\r\nLead Quality Placeholder:\r\n“Before working with us, most inquiries were people asking only for price. After improving the offer, targeting, and follow-up process, the business started receiving more serious conversations.”\r\n\r\nBooking Growth Placeholder:\r\n“A clinic, coach, restaurant, boutique, real estate agent, or service provider can use this section to show more bookings, inquiries, or sales after implementing the system.”\r\n\r\nTestimonials:\r\n“Before this, I was boosting posts and hoping something would happen. Now I understand what is working, where my leads are coming from, and what to improve next.”\r\n\r\n“The biggest difference was clarity. I finally knew why my ads were not converting and what needed to be fixed.”\r\n\r\nAdd a note:\r\nReplace these with your real case studies, screenshots, and testimonials when available.\r\n\r\nOBJECTION HANDLING SECTION:\r\nHeading:\r\nStill Wondering If This Is Right For You?\r\n\r\nCreate accordion FAQ-style objection cards:\r\n\r\nQuestion: “I tried ads before and they didn’t work.”\r\nAnswer:\r\nThat is common. But in many cases, the issue was not Meta Ads. The issue was the setup: no clear offer, no proper targeting, no strong ad message, no tracking, no retargeting, and no follow-up system. That is why our approach is different. We build the full system around the ads.\r\n\r\nQuestion: “I don’t have a huge ad budget.”\r\nAnswer:\r\nYou do not need to start with a huge budget. You need to start with a smart strategy. Many business owners waste money because they spend before fixing the basics. We help you understand what should be fixed first, what to test, and how to avoid careless spending.\r\n\r\nQuestion: “How do I know this will work for my business?”\r\nAnswer:\r\nWe start by looking at your business, your offer, your audience, and your current marketing. That way, you are not buying a generic service. You are getting a clear plan based on where your business is now.\r\n\r\nQuestion: “I don’t want fake leads.”\r\nAnswer:\r\nNeither do we. Cheap leads are not the goal. The goal is to attract better-quality inquiries from people who are more likely to need your product or service. That is why we focus on the offer, message, targeting, creative, and follow-up process.\r\n\r\nQuestion: “I don’t have time to manage all this.”\r\nAnswer:\r\nThat is exactly why this service exists. You do not need to become a Meta Ads expert. You need someone to handle the strategy, setup, optimization, and reporting so you can focus on running your business.\r\n\r\nQuestion: “What if the reports look good but sales do not improve?”\r\nAnswer:\r\nWe do not focus only on likes, reach, and clicks. Those numbers can be useful, but they do not pay the bills. We focus on leads, messages, calls, bookings, sales opportunities, and what happens after the lead comes in.\r\n\r\nRISK REVERSAL / REASSURANCE SECTION:\r\nHeading:\r\nStart With Clarity Before Spending More\r\n\r\nCopy:\r\nBefore asking you to spend more money on ads, we first help you understand what is currently broken.\r\n\r\nThat is why the first step is a Meta Ads audit.\r\n\r\nYou will get a clear view of:\r\n- What is leaking money\r\n- What needs to be fixed\r\n- What opportunities are being missed\r\n- What kind of system your business needs\r\n\r\nNo pressure.\r\nNo confusing jargon.\r\nNo vague promises.\r\nJust a clear plan to help you make a smarter decision.\r\n\r\nCTA:\r\nBook Your Free Meta Ads Audit\r\n\r\nURGENCY / SCARCITY SECTION:\r\nHeading:\r\nIf Your Ads Are Already Wasting Money, Waiting Will Not Fix It\r\n\r\nCopy:\r\nEvery month you continue guessing, you may be losing leads to competitors who have a better system.\r\n\r\nIf your current marketing is bringing likes but not customers, now is the time to find out why.\r\n\r\nWe only take a limited number of businesses at a time because proper campaign setup, testing, and optimization require attention.\r\n\r\nSo if you want help building a more predictable lead system, start with the audit.\r\n\r\nFAQ SECTION:\r\nCreate a clean FAQ section with these questions:\r\n1. What is a Meta Ads audit?\r\n2. Do I need to already be running ads?\r\n3. Can this work if I only boosted posts before?\r\n4. Do I need a big ad budget?\r\n5. Will you manage the ads for me?\r\n6. Can you help with ad copy and creative direction?\r\n7. Do you help with lead follow-up?\r\n8. How do I get started?\r\n\r\nAnswer these using the same simple, reassuring tone from the landing page.\r\n\r\nFINAL CTA SECTION:\r\nHeading:\r\nReady To Stop Guessing And Start Growing With A Clear Meta Ads System?\r\n\r\nCopy:\r\nIf you are tired of boosted posts, random leads, inconsistent sales, and confusing ad results, let’s look at what is really going on.\r\n\r\nBook your free Meta Ads audit today.\r\n\r\nWe will show you what is working, what is not, and what should be fixed first.\r\n\r\nBullet outcomes:\r\n- Get more qualified leads\r\n- Get more serious inquiries\r\n- Know where your money is going\r\n- Build a system that helps your business grow with more clarity and control\r\n\r\nCTA buttons:\r\nBook Your Free Meta Ads Audit\r\nMessage Us on WhatsApp\r\n\r\nRepeated CTA line:\r\nStop boosting posts that only get likes. Build a Meta Ads system that brings real inquiries, qualified leads, and measurable growth.\r\n\r\nFOOTER:\r\nInclude:\r\n- Meta Ads Expert\r\n- Short description: Helping business owners turn Facebook and Instagram into a predictable customer-generating system.\r\n- Navigation links\r\n- CTA link\r\n- Copyright\r\n- Placeholder social links\r\n\r\nCRO REQUIREMENTS:\r\nUse clear CTAs throughout the page.\r\nRepeat CTAs after major sections.\r\nUse benefit-driven copy.\r\nUse trust signals.\r\nUse social proof placeholders without fake claims.\r\nUse authority positioning.\r\nUse scarcity carefully and naturally.\r\nUse simple language a business owner can instantly understand.\r\nMake the page feel like a helpful conversation, not a hard sales pitch.\r\nReduce risk and uncertainty throughout.\r\nPosition the offer as a complete system, not just ad management.\r\nFocus on emotional resonance first, then logic, then proof, then CTA.\r\n\r\nCOMPONENT SUGGESTIONS:\r\nCreate reusable components such as:\r\n- Header\r\n- Button\r\n- SectionHeading\r\n- FeatureCard\r\n- StepCard\r\n- TestimonialCard\r\n- FAQAccordion\r\n- CTASection\r\n- Footer\r\n\r\nFUNCTIONALITY:\r\nCTA buttons should use placeholder links:\r\n- Book Free Audit: /contact or #contact\r\n- WhatsApp: https://wa.me/YOUR_NUMBER_HERE\r\nCreate a contact/audit form section or modal with fields:\r\n- Name\r\n- Business name\r\n- Email\r\n- WhatsApp number\r\n- Website or social media link\r\n- What are you struggling with?\r\n- Monthly ad budget range\r\n- Submit button: Request Free Audit\r\n\r\nThe form does not need backend integration. Add clear TODO comments for future integration with email, CRM, or WhatsApp automation.\r\n\r\nPERFORMANCE:\r\nUse optimized fonts.\r\nAvoid heavy libraries unless needed.\r\nUse CSS/Tailwind for visual design.\r\nUse lazy loading where appropriate.\r\nKeep animations lightweight.\r\nMake sure Lighthouse performance, accessibility, SEO, and best practices are strong.\r\n\r\nFINAL DELIVERY:\r\nGenerate the complete Next.js project code with clear file structure.\r\nInclude all required files.\r\nUse Tailwind CSS.\r\nMake it production-ready.\r\nMake the landing page visually polished, responsive, and conversion-focused.\r\nDo not use generic lorem ipsum.\r\nUse the provided copy and structure above.\r\nDo not invent fake client results, fake testimonials, or fake company claims beyond the provided placeholders.","where is run","npm install\r\nnpm run dev\r","run in my project","```text\r\nYou are an expert senior Next.js developer, UI/UX designer, CRO specialist, and direct-response landing page strategist.\r\n\r\nBuild a production-ready personal portfolio website for a Meta Ads expert.\r\n\r\nWebsite purpose:\r\nA personal portfolio website for a Meta Ads expert who helps business owners replace random posting, boosted posts, weak ads, and guesswork with a complete Meta Ads system that brings real inquiries, qualified leads, bookings, and sales.\r\n\r\nTheme:\r\nLight theme. Modern SaaS/startup style. Clean, minimal, professional, conversion-focused, trustworthy, and easy to read on mobile.\r\n\r\nPrimary conversion goal:\r\nGet business owners to book a free Meta Ads audit or message on WhatsApp.\r\n\r\nMain CTAs:\r\n- Book Your Free Meta Ads Audit\r\n- Message Us on WhatsApp\r\n\r\nTECH REQUIREMENTS:\r\nUse the latest version of Next.js with the App Router.\r\nUse Tailwind CSS.\r\nCreate a clean and scalable project structure.\r\nMake the website fully responsive across mobile, tablet, and desktop.\r\nWrite production-ready, maintainable code.\r\nOptimize for fast performance.\r\nUse reusable components.\r\nUse semantic HTML.\r\nUse accessible buttons, links, sections, and forms.\r\nUse clean spacing, readable typography, and strong visual hierarchy.\r\nAvoid unnecessary animation that slows performance.\r\nAdd subtle, smooth animations only where they improve the user experience.\r\n\r\nSEO REQUIREMENTS:\r\nAdd proper metadata using Next.js metadata API.\r\nMeta title: Meta Ads Expert | Predictable Lead Growth System\r\nMeta description: Stop boosting posts that get likes but no customers. Build a Meta Ads system that brings qualified leads, real inquiries, bookings, and measurable growth.\r\nAdd Open Graph tags.\r\nUse proper heading hierarchy: one H1, then H2 and H3 correctly.\r\nUse semantic sections.\r\nMake the layout SEO-friendly and fast-loading.\r\nUse descriptive alt text for any images or placeholders.\r\nUse clean URLs and page structure.\r\n\r\nDESIGN DIRECTION:\r\nCreate a light-themed modern portfolio/landing page.\r\nStyle should feel like a premium SaaS/startup website, not a generic freelancer page.\r\nUse a mostly white or very light background.\r\nUse soft gradients, subtle shadows, rounded cards, clean borders, and professional spacing.\r\nUse a strong accent color suitable for Meta Ads/business growth, such as blue, indigo, or a blue-purple gradient.\r\nUse clear typography with large bold headlines and easy-to-read body text.\r\nUse conversion-focused layout with repeated CTAs.\r\nDesign must feel trustworthy, calm, clear, and premium.\r\nMake it mobile-first.\r\n\r\nWEBSITE STRUCTURE:\r\nBuild a single high-converting landing page with these sections:\r\n\r\n1. Header / Navigation\r\n2. Hero section with strong value proposition\r\n3. Pain / hook section\r\n4. Problem agitation section\r\n5. Solution introduction\r\n6. How it works section\r\n7. Benefits and outcomes section\r\n8. What’s included section\r\n9. Bonuses section\r\n10. Social proof / credibility section\r\n11. Objection handling section\r\n12. Risk reversal / reassurance section\r\n13. Urgency / scarcity section\r\n14. FAQ section\r\n15. Final call-to-action section\r\n16. Footer\r\n\r\nHEADER:\r\nCreate a sticky or clean top navigation.\r\nLogo/name placeholder: “Meta Ads Expert”\r\nNavigation links:\r\n- Problem\r\n- System\r\n- Process\r\n- Results\r\n- FAQ\r\nCTA button: Book Free Audit\r\n\r\nHERO SECTION:\r\nUse this copy and improve only formatting, not meaning:\r\n\r\nHeadline:\r\nStop Boosting Posts That Get Likes But No Customers\r\n\r\nSubheadline:\r\nTurn Facebook and Instagram into a predictable customer-generating system that brings real inquiries, qualified leads, bookings, and sales.\r\n\r\nSupport copy:\r\nWe help business owners replace random posting, weak boosted ads, and guesswork with a complete Meta Ads system built to attract people who are actually ready to buy.\r\n\r\nPrimary CTA:\r\nBook Your Free Meta Ads Audit\r\n\r\nSecondary CTA:\r\nMessage Us on WhatsApp\r\n\r\nAdd trust microcopy near the CTA:\r\nNo pressure. No confusing jargon. Just a clear look at what is working and what is not.\r\n\r\nHero visual:\r\nCreate a clean dashboard-style visual card showing:\r\n- Qualified Leads\r\n- Real Inquiries\r\n- Bookings\r\n- Sales Opportunities\r\n- Ad Spend Clarity\r\nUse placeholder metrics, but make them look realistic and clearly mark them as examples if needed.\r\n\r\nHOOK SECTION:\r\nUse short emotional copy with strong spacing:\r\n\r\nIf this sounds familiar, you are not alone.\r\n\r\nYou post on Facebook and Instagram.\r\nYou boost a few posts.\r\nYou get some likes, comments, and maybe a few messages.\r\n\r\nBut when you check the real result…\r\n\r\nNo serious buyers.\r\nNo consistent bookings.\r\nNo clear return.\r\nNo idea what is working.\r\n\r\nAnd the worst part?\r\n\r\nYou know your business is good.\r\nYou know your product or service can help people.\r\nBut not enough people are seeing it, trusting it, or buying from you.\r\n\r\nDesign this section with a clean two-column layout on desktop:\r\nLeft side: emotional copy.\r\nRight side: a card titled “What usually happens” with bullet points:\r\n- Likes but no customers\r\n- Messages that disappear\r\n- Weak lead quality\r\n- Unclear return\r\n- Random monthly sales\r\n\r\nPROBLEM AGITATION SECTION:\r\nHeading:\r\nThe problem is not that Meta Ads “don’t work.”\r\n\r\nSubheading:\r\nThe problem is that most businesses are using them the wrong way.\r\n\r\nInclude these problem points in cards:\r\n- Boosting posts without a strategy\r\n- Running ads without a strong offer\r\n- Copying competitors and hoping something works\r\n- Sending traffic to weak pages or messy inboxes\r\n- Judging ads too early\r\n- Stopping campaigns before proper testing\r\n- Looking at likes, clicks, and reach instead of leads, bookings, and sales\r\n\r\nAdd copy:\r\nThat is why it feels like you are spending money but not moving forward.\r\n\r\nAdd quote-style cards:\r\n“I tried ads before and they didn’t work.”\r\n“People message ‘price?’ and disappear.”\r\n“I need more customers, not just engagement.”\r\n“Some months are good, some months are terrible.”\r\n“I want to grow, but I don’t understand all this technical stuff.”\r\n\r\nEnd section with:\r\nThis is exactly why you do not need “just ads.”\r\nYou need a system.\r\n\r\nSOLUTION INTRODUCTION SECTION:\r\nHeading:\r\nIntroducing The Predictable Lead Growth System\r\n\r\nCopy:\r\nA complete Meta Ads system designed to help business owners get more qualified leads, inquiries, bookings, calls, or online sales from Facebook and Instagram.\r\n\r\nWe do not just run ads.\r\nWe help build the full customer journey.\r\n\r\nThat means we look at your offer, audience, ad message, creative, campaign setup, tracking, retargeting, and follow-up process.\r\n\r\nBecause ads alone do not grow a business.\r\nA working system does.\r\n\r\nHighlight box:\r\nThe goal is simple:\r\nTo help you stop guessing and start knowing what is bringing customers into your business.\r\n\r\nAdd CTA:\r\nBook Your Free Meta Ads Audit\r\nMessage Us on WhatsApp\r\n\r\nHOW IT WORKS SECTION:\r\nHeading:\r\nHow The System Works\r\n\r\nCreate four step cards with numbers and icons:\r\n\r\nStep 1: We Audit What You Are Doing Now\r\nCopy:\r\nFirst, we look at your current marketing, ads, boosted posts, offer, audience, landing page or lead form, follow-up process, and results. We find where things are breaking. No guessing. No confusing jargon.\r\n\r\nStep 2: We Build Your Growth Strategy\r\nCopy:\r\nNext, we create a simple campaign roadmap. We decide what offer to promote, who to target, what message to use, what type of creative to test, where leads should go, how to track results, and how to follow up.\r\n\r\nStep 3: We Launch Your Meta Ads System\r\nCopy:\r\nThen we set up and manage your campaigns across Facebook and Instagram. This can include lead generation campaigns, message campaigns, retargeting, creative testing, and tracking setup.\r\n\r\nStep 4: We Track, Optimize, and Improve\r\nCopy:\r\nOnce your campaigns are live, we monitor the numbers, check lead quality, test new creatives, adjust campaigns, and show you what is happening in simple reports.\r\n\r\nBENEFITS SECTION:\r\nHeading:\r\nWhat This Can Help You Do\r\n\r\nCreate benefit cards:\r\n1. Get More Qualified Inquiries\r\nCopy: Not just random likes or people asking for discounts. The goal is to attract people who understand your offer and are more likely to become customers.\r\n\r\n2. Stop Depending Only on Referrals\r\nCopy: Referrals are great, but they are not predictable. With the right Meta Ads system, your business can start building a steadier pipeline of prospects.\r\n\r\n3. Know What Is Actually Working\r\nCopy: No more wondering whether your posts, ads, or budget are helping. You get simple reporting that shows what is bringing leads, inquiries, bookings, or sales.\r\n\r\n4. Feel More in Control of Growth\r\nCopy: You should not have to wake up every day hoping business will be good. The goal is to create a system that gives you more clarity, confidence, and control.\r\n\r\n5. Spend Smarter, Not Randomly\r\nCopy: We help you avoid wasting money on boosted posts, weak offers, unclear targeting, and campaigns with no tracking.\r\n\r\nWHAT’S INCLUDED SECTION:\r\nHeading:\r\nThe Predictable Lead Growth System Includes\r\n\r\nUse a grid of clean cards:\r\n- Business & Ad Account Audit: We review your current setup and find the biggest leaks.\r\n- Offer Strategy: We help position your offer so it is easier for people to understand and respond to.\r\n- Audience Research: We identify the people most likely to need your product or service.\r\n- Ad Copywriting: We write clear, simple, persuasive ad copy that speaks to your customer’s real pain and desire.\r\n- Creative Direction: We guide the ad visuals, videos, hooks, and angles that should be tested.\r\n- Campaign Setup: We build your Meta Ads campaigns properly instead of relying on random boosting.\r\n- Tracking Setup Guidance: We help you understand what should be tracked so you can judge results properly.\r\n- Lead Form or Landing Page Guidance: We help improve the path people take after they click your ad.\r\n- Retargeting Campaigns: We help bring back people who showed interest but did not take action yet.\r\n- Weekly Optimization: We monitor, adjust, and improve campaigns based on performance.\r\n- Simple Performance Reporting: No confusing dashboards. Just clear reporting on what matters.\r\n- Lead Follow-Up Recommendations: Because leads only matter if they are followed up properly.\r\n\r\nBONUSES SECTION:\r\nHeading:\r\nIncluded Bonuses\r\n\r\nCreate four highlighted bonus cards:\r\nBonus 1: Meta Ads Leak Audit\r\nCopy: We identify what may be causing wasted spend, poor lead quality, or low conversions.\r\n\r\nBonus 2: Offer Clarity Review\r\nCopy: Many businesses do not have an ad problem. They have an offer problem. We help review your offer so people instantly understand why they should contact you.\r\n\r\nBonus 3: Lead Follow-Up Checklist\r\nCopy: Getting leads is only the first step. We give you a simple checklist to help your team respond faster, qualify better, and avoid losing interested prospects.\r\n\r\nBonus 4: “Boost Post vs Real Campaign” Breakdown\r\nCopy: You will understand why boosted posts often bring likes instead of customers, and what a proper campaign should do differently.\r\n\r\nSOCIAL PROOF / CREDIBILITY SECTION:\r\nHeading:\r\nReal Businesses Need Real Results\r\n\r\nUse placeholder-style proof angles because exact client results are not provided.\r\nMake it visually credible but do not invent fake numbers.\r\n\r\nCreate cards:\r\nCase Study Placeholder:\r\n“How we helped a local service business move from random boosted posts to a structured lead generation campaign that brought steady inquiries.”\r\n\r\nLead Quality Placeholder:\r\n“Before working with us, most inquiries were people asking only for price. After improving the offer, targeting, and follow-up process, the business started receiving more serious conversations.”\r\n\r\nBooking Growth Placeholder:\r\n“A clinic, coach, restaurant, boutique, real estate agent, or service provider can use this section to show more bookings, inquiries, or sales after implementing the system.”\r\n\r\nTestimonials:\r\n“Before this, I was boosting posts and hoping something would happen. Now I understand what is working, where my leads are coming from, and what to improve next.”\r\n\r\n“The biggest difference was clarity. I finally knew why my ads were not converting and what needed to be fixed.”\r\n\r\nAdd a note:\r\nReplace these with your real case studies, screenshots, and testimonials when available.\r\n\r\nOBJECTION HANDLING SECTION:\r\nHeading:\r\nStill Wondering If This Is Right For You?\r\n\r\nCreate accordion FAQ-style objection cards:\r\n\r\nQuestion: “I tried ads before and they didn’t work.”\r\nAnswer:\r\nThat is common. But in many cases, the issue was not Meta Ads. The issue was the setup: no clear offer, no proper targeting, no strong ad message, no tracking, no retargeting, and no follow-up system. That is why our approach is different. We build the full system around the ads.\r\n\r\nQuestion: “I don’t have a huge ad budget.”\r\nAnswer:\r\nYou do not need to start with a huge budget. You need to start with a smart strategy. Many business owners waste money because they spend before fixing the basics. We help you understand what should be fixed first, what to test, and how to avoid careless spending.\r\n\r\nQuestion: “How do I know this will work for my business?”\r\nAnswer:\r\nWe start by looking at your business, your offer, your audience, and your current marketing. That way, you are not buying a generic service. You are getting a clear plan based on where your business is now.\r\n\r\nQuestion: “I don’t want fake leads.”\r\nAnswer:\r\nNeither do we. Cheap leads are not the goal. The goal is to attract better-quality inquiries from people who are more likely to need your product or service. That is why we focus on the offer, message, targeting, creative, and follow-up process.\r\n\r\nQuestion: “I don’t have time to manage all this.”\r\nAnswer:\r\nThat is exactly why this service exists. You do not need to become a Meta Ads expert. You need someone to handle the strategy, setup, optimization, and reporting so you can focus on running your business.\r\n\r\nQuestion: “What if the reports look good but sales do not improve?”\r\nAnswer:\r\nWe do not focus only on likes, reach, and clicks. Those numbers can be useful, but they do not pay the bills. We focus on leads, messages, calls, bookings, sales opportunities, and what happens after the lead comes in.\r\n\r\nRISK REVERSAL / REASSURANCE SECTION:\r\nHeading:\r\nStart With Clarity Before Spending More\r\n\r\nCopy:\r\nBefore asking you to spend more money on ads, we first help you understand what is currently broken.\r\n\r\nThat is why the first step is a Meta Ads audit.\r\n\r\nYou will get a clear view of:\r\n- What is leaking money\r\n- What needs to be fixed\r\n- What opportunities are being missed\r\n- What kind of system your business needs\r\n\r\nNo pressure.\r\nNo confusing jargon.\r\nNo vague promises.\r\nJust a clear plan to help you make a smarter decision.\r\n\r\nCTA:\r\nBook Your Free Meta Ads Audit\r\n\r\nURGENCY / SCARCITY SECTION:\r\nHeading:\r\nIf Your Ads Are Already Wasting Money, Waiting Will Not Fix It\r\n\r\nCopy:\r\nEvery month you continue guessing, you may be losing leads to competitors who have a better system.\r\n\r\nIf your current marketing is bringing likes but not customers, now is the time to find out why.\r\n\r\nWe only take a limited number of businesses at a time because proper campaign setup, testing, and optimization require attention.\r\n\r\nSo if you want help building a more predictable lead system, start with the audit.\r\n\r\nFAQ SECTION:\r\nCreate a clean FAQ section with these questions:\r\n1. What is a Meta Ads audit?\r\n2. Do I need to already be running ads?\r\n3. Can this work if I only boosted posts before?\r\n4. Do I need a big ad budget?\r\n5. Will you manage the ads for me?\r\n6. Can you help with ad copy and creative direction?\r\n7. Do you help with lead follow-up?\r\n8. How do I get started?\r\n\r\nAnswer these using the same simple, reassuring tone from the landing page.\r\n\r\nFINAL CTA SECTION:\r\nHeading:\r\nReady To Stop Guessing And Start Growing With A Clear Meta Ads System?\r\n\r\nCopy:\r\nIf you are tired of boosted posts, random leads, inconsistent sales, and confusing ad results, let’s look at what is really going on.\r\n\r\nBook your free Meta Ads audit today.\r\n\r\nWe will show you what is working, what is not, and what should be fixed first.\r\n\r\nBullet outcomes:\r\n- Get more qualified leads\r\n- Get more serious inquiries\r\n- Know where your money is going\r\n- Build a system that helps your business grow with more clarity and control\r\n\r\nCTA buttons:\r\nBook Your Free Meta Ads Audit\r\nMessage Us on WhatsApp\r\n\r\nRepeated CTA line:\r\nStop boosting posts that only get likes. Build a Meta Ads system that brings real inquiries, qualified leads, and measurable growth.\r\n\r\nFOOTER:\r\nInclude:\r\n- Meta Ads Expert\r\n- Short description: Helping business owners turn Facebook and Instagram into a predictable customer-generating system.\r\n- Navigation links\r\n- CTA link\r\n- Copyright\r\n- Placeholder social links\r\n\r\nCRO REQUIREMENTS:\r\nUse clear CTAs throughout the page.\r\nRepeat CTAs after major sections.\r\nUse benefit-driven copy.\r\nUse trust signals.\r\nUse social proof placeholders without fake claims.\r\nUse authority positioning.\r\nUse scarcity carefully and naturally.\r\nUse simple language a business owner can instantly understand.\r\nMake the page feel like a helpful conversation, not a hard sales pitch.\r\nReduce risk and uncertainty throughout.\r\nPosition the offer as a complete system, not just ad management.\r\nFocus on emotional resonance first, then logic, then proof, then CTA.\r\n\r\nCOMPONENT SUGGESTIONS:\r\nCreate reusable components such as:\r\n- Header\r\n- Button\r\n- SectionHeading\r\n- FeatureCard\r\n- StepCard\r\n- TestimonialCard\r\n- FAQAccordion\r\n- CTASection\r\n- Footer\r\n\r\nFUNCTIONALITY:\r\nCTA buttons should use placeholder links:\r\n- Book Free Audit: /contact or #contact\r\n- WhatsApp: https://wa.me/YOUR_NUMBER_HERE\r\nCreate a contact/audit form section or modal with fields:\r\n- Name\r\n- Business name\r\n- Email\r\n- WhatsApp number\r\n- Website or social media link\r\n- What are you struggling with?\r\n- Monthly ad budget range\r\n- Submit button: Request Free Audit\r\n\r\nThe form does not need backend integration. Add clear TODO comments for future integration with email, CRM, or WhatsApp automation.\r\n\r\nPERFORMANCE:\r\nUse optimized fonts.\r\nAvoid heavy libraries unless needed.\r\nUse CSS/Tailwind for visual design.\r\nUse lazy loading where appropriate.\r\nKeep animations lightweight.\r\nMake sure Lighthouse performance, accessibility, SEO, and best practices are strong.\r\n\r\nFINAL DELIVERY:\r\nGenerate the complete Next.js project code with clear file structure.\r\nInclude all required files.\r\nUse Tailwind CSS.\r\nMake it production-ready.\r\nMake the landing page visually polished, responsive, and conversion-focused.\r\nDo not use generic lorem ipsum.\r\nUse the provided copy and structure above.\r\nDo not invent fake client results, fake testimonials, or fake company claims beyond the provided placeholders.\r\n```\r","src/\r\n  app/\r\n  components/\r\npublic/  \naddd this files in som-website folder","“If any files are missing, please complete them inside the Som Website folder.”","update my logo. Remove the text form the logo and place the full length of the logo\n\n\"D:\\som-website\\public\\Main logo.png\"","run","my logo make it little bigger","my logo make it little bigger","again my logo make it little bigger","change the  favicon \"D:\\som-website\\public\\favicon.png\"","my  favicon logo make it little bigger","change the  favicon \"D:\\som-website\\public\\favicon.jpg\"","RUN","again my logo make it little bigger","again my favicon logo make it little bigger","my favicon logo \"D:\\som-website\\public\\favicon-jpg.jpg\"","change my favicon logo \"D:\\som-website\\public\\favicon-jpg.jpg\""],"electron:onboarding-hide-first-new-thread-promos":false,"electron:onboarding-plugin-checklist-active":false,"has-seen-knowledge-work-announcement":true,"codexCloudAccess":"enabled_needs_setup","last-used-continue-in-mode":"local","browser-sidebar-comment-mode-coachmark-dismissed":true,"app-shell:right-panel-width:v2:/local/:conversationId":0,"seen-model-upgrade-list":["gpt-5.5"],"markdownCodeBlockWordWrap":false,"diff-filter":"last-turn"},"electron-main-window-bounds":{"x":232,"y":29,"width":1024,"height":680,"isMaximized":true},"conversationDetailMode":"STEPS_COMMANDS","ambient-suggestions-enabled":false,"appearanceLightChromeTheme":{"accent":"#aec3d7","contrast":45,"fonts":{"code":null,"ui":null},"ink":"#edf3fc","opaqueWindows":false,"semanticColors":{"diffAdded":"#00a240","diffRemoved":"#ba2623","skill":"#924ff7"},"surface":"#300b0b"},"appearanceTheme":"dark","use-copilot-auth-if-available":false,"electron-saved-workspace-roots":["D:\\som-website"],"project-order":["D:\\som-website"],"active-workspace-roots":["D:\\som-website"],"open-in-target-preferences":{"global":"fileManager","perPath":{"D:\\som-website-codex":"fileManager"}}}